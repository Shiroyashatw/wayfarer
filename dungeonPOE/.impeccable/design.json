      "html": "<button class=\"ds-btn\">放進倉庫</button>",
      "css": ".ds-btn{font:700 14px \"Noto Sans TC\",sans-serif;color:#e9dfcd;background:linear-gradient(180deg,#221a13,#120e0b);border:1px solid #5a4628;border-radius:2px;box-shadow:inset 0 1px 0 rgba(255,225,170,.06);padding:10px 18px;min-height:44px;cursor:pointer}.ds-btn:hover{border-color:#b8955a;color:#e6c88e}.ds-btn:focus-visible{outline:1px solid #d7b77c;outline-offset:2px}.ds-btn:active{transform:scale(.97)}"
